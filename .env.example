# =================================================================
# Spica 設定ファイル テンプレート
#   このファイルをコピーして .env を作成してください:
#     cp .env.example .env
#   各項目の詳細は docs/CONFIGURATION.md を参照してください。
# =================================================================

# -----------------------------------------------------------------
# 基本設定
# -----------------------------------------------------------------
# サーバー待受ポート番号 (デフォルト: 3000)
PORT=3000

# サーバーバインドアドレス (0.0.0.0 で全インターフェース待受)
BIND_HOST=0.0.0.0

# サーバーの外部公開ドメイン名
# ⚠️ 必ず実際に外部からアクセスされるホスト名と完全一致させてください。
#    HTTP Signature の検証で「署名された host」の候補として使われるため、
#    ここが誤っていると連合（他サーバーとの送受信）が失敗します。
#    ポートを含めないでください（例: spica.example.com）。
DOMAIN=localhost:3000

# 通信プロトコル (https または http)
# ローカル開発では http、インターネットへ公開する場合は https
PROTOCOL=http

# SQLite データベースファイルのパス
# 相対パスの場合はサーバーの作業ディレクトリ (server/) を基準に解決されます
DB_PATH=data_astrabit.sqlite

# データベースの種類 (sqlite または postgres)
# 既定は sqlite。postgres を選ぶと DATABASE_URL に接続します (実験的。docs/POSTGRESQL.md)
# DB_DRIVER=postgres

# PostgreSQL の接続文字列 (DB_DRIVER=postgres のとき必須)
# パスワードを含むため、この値は公開リポジトリに置かないでください
# DATABASE_URL=postgres://spica:password@127.0.0.1:5432/spica

# コネクションプールの本数 (既定 5。同時に走るクエリの上限でもあります)
# DATABASE_POOL_MAX=5

# PostgreSQL の 1 クエリの上限 (ミリ秒。0 で無効。既定 30000)
# 重いクエリやロック待ちが 1 本の接続を長時間占有し続けないための保険です
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# アイドル状態のトランザクションを切るまでの時間 (ミリ秒。0 で無効。既定 60000)
# DATABASE_IDLE_TIMEOUT_MS=60000

# Redis (任意)。未設定なら今までどおりインメモリで動きます (1 プロセス前提)。
# 設定するとレート制限・リアルタイム更新・設定の反映・定期処理の単一実行が共有され、
# 複数のプロセスで動かせるようになります (手順: docs/REDIS.md)
# パスワードを含むため、この値は公開リポジトリに置かないでください
# REDIS_URL=redis://127.0.0.1:6379

# 同じ Redis を複数のノードで共有する場合は、ノードごとに分けてください (既定 spica)
# REDIS_PREFIX=spica

# 配送再送の同時実行数 (既定 5)。相手サーバーごとに速さが違うので、並べると同じ時間で多く送れます
# DELIVERY_CONCURRENCY=5

# タイムラインの読み取りキャッシュの TTL (秒。既定 0 = 無効)
# 有効にすると同じ画面を何度も開いたときの組み立てを省けます (Redis があれば全プロセスで共有)
# ただしブロック・削除・フォローの反映が TTL ぶん遅れます (他人に漏れることはありません)
# TIMELINE_CACHE_TTL_SEC=15

# タグタイムラインと検索が走査する「直近の投稿数」(既定 20000)
# 本文の部分一致 (LIKE) は索引が使えないため、直近 N 件に限って全件走査を避けます
# 広げるほど古い投稿のタグ・語も見つかりますが、そのぶん 1 回の走査が重くなります
# (実測: 2 万件で 17ms / 5 万件で 40ms / 10 万件で 139ms)。0 で無制限 (従来の挙動)
# RECENT_SCAN_POSTS=20000

# /metrics (Prometheus 形式) を出すためのトークン。未設定なら /metrics は 404 です
# 取得は `Authorization: Bearer <トークン>` (Prometheus の bearer_token) で行います
# nginx の背後では接続元 IP で守れない (全部 127.0.0.1 になる) ため、トークンで守ります
# METRICS_TOKEN=change-me

# CDN (例: Cloudflare) を前段に置くときの、メディアの公開 URL
# 設定すると API の応答に含まれる自分のメディア (/uploads/...) をこの URL に置き換えます
# (DB には相対のまま保存するので、後から CDN を替えられます)
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com

# ノード・インスタンス表示名
INSTANCE_NAME=Spica

# ノード・インスタンス説明文
INSTANCE_DESCRIPTION=Spica - A decentralized, sovereign social network node built from scratch with ActivityPub.

# -----------------------------------------------------------------
# オブジェクトストレージ設定 (Cloudflare R2 / AWS S3互換)
# ※ 空欄の場合はサーバーローカル (data/uploads) に保存されます
# -----------------------------------------------------------------
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=spica-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.example.com

# -----------------------------------------------------------------
# メディアアップロード上限
# -----------------------------------------------------------------
# 動画・音声の1ファイルあたりの上限 (バイト)。既定は 50MB (52428800)
# 画像は 15MB 固定です。
# MEDIA_MAX_BYTES=52428800

# -----------------------------------------------------------------
# Web Push 通知 (PWA / モバイルブラウザ向け)
# -----------------------------------------------------------------
# 未設定の場合は初回起動時に自動生成され、データベースに保存されます。
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# -----------------------------------------------------------------
# メール送信 (SMTP)
# -----------------------------------------------------------------
# マスターキーの復元メールやメールアドレス確認に使います。
# 通常は管理画面「メール・認証」から設定してください（こちらが優先されます）。
# 未設定のあいだ、メール関連の機能は自動的に無効になります。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com

# -----------------------------------------------------------------
# Inbox 署名検証 (HTTP Signature)
# -----------------------------------------------------------------
# strict: 署名検証に失敗した Activity を 401 で拒否します（既定・推奨）
# log:    検証失敗でもそのまま処理します（従来挙動・非推奨。なりすまし投稿が可能になります）
INBOX_SIGNATURE_MODE=strict

# 署名鍵の持ち主と Activity の actor が異なる「代理転送」の許可方針
# relay: 管理画面で承認済み(accepted)のリレーからの転送のみ許可（既定・推奨）
# any:   誰からの転送でも許可（互換性最大・なりすまし可能になるため非推奨）
INBOX_FORWARDED_ACTIVITY_POLICY=relay

# 署名 Date ヘッダーの許容幅（秒）。既定は 12 時間（43200）。リプレイ対策
SIGNATURE_MAX_AGE_SECONDS=43200

# プライベートアドレス宛の remote actor 取得を許可するか（SSRF 対策）
# 本番(https)では既定で false。同じ LAN 内の自前ノードと連合テストする場合のみ true
# ALLOW_PRIVATE_REMOTE_FETCH=false

# -----------------------------------------------------------------
# Authorized Fetch（署名必須モード）
# -----------------------------------------------------------------
# 有効にすると ActivityPub の取得（Actor 文書・フォロワー一覧・ノート）に
# 有効な HTTP Signature を必須にし、こちらからの取得にも署名を付けます。
# WebFinger / NodeInfo / 画面表示(HTML) / メディアは対象外のままです。
# ⚠️ 署名せずに取得してくる相手（古い実装など）からは取得できなくなるため、
#    連合の互換性は下がります。鍵アカウントの保護を実効化したい場合に有効にしてください。
# AUTHORIZED_FETCH=false

# -----------------------------------------------------------------
# レート制限（スパム・総当たり対策）
# -----------------------------------------------------------------
# 既定で有効です（認証 20回/分、API 600回/分、Inbox 3000回/分 / IP単位）。
# テストや特殊な運用で無効化したい場合のみ true にしてください。
# RATE_LIMIT_DISABLED=false

# -----------------------------------------------------------------
# DB メンテナンス（1人運用向け）
# -----------------------------------------------------------------
# `npm run db:maintenance` で、リモート投稿の整理・孤立メディアの削除・
# VACUUM による縮小・VACUUM INTO によるバックアップを行います。
#
# まずドライランで確認し、問題なければ --apply を付けて実行してください:
#   npm run db:maintenance              # 削除予定の確認（何も消しません）
#   npm run db:maintenance -- --apply   # 実行（先にバックアップを取ります）
#
# VACUUM は DB を排他ロックするため、サーバーを停止してから実行するのが確実です
# （バックアップと投稿削除はサーバー起動中でも動きます）。
#
# リモート投稿の保持日数。リレー経由で流入したリモート投稿が DB を膨らませるため、
# これより古いものを削除します（既定 30 日、0 で期間による削除を行わない）。
# コマンドの --days オプションで上書きできます。
# REMOTE_POST_RETENTION_DAYS=30

# -----------------------------------------------------------------
# ドライブ（自分のアップロード管理）
# -----------------------------------------------------------------
# アップロードしたメディアは「ドライブ」から一覧・削除できます（投稿に添付しなくても残ります）。
# 容量上限を設けたい場合は MB 単位で指定してください（0 または未設定で無制限）。
# 上限に達すると新しいアップロードが 413 で拒否され、ドライブに案内が出ます。
# MEDIA_QUOTA_MB=1024

# -----------------------------------------------------------------
# 動画サムネイル（ffmpeg・任意）
# -----------------------------------------------------------------
# ffmpeg がインストールされていれば、動画アップロード時に先頭付近の 1 フレームから
# サムネイル（WebP）を生成し、タイムラインでは静止画＋再生ボタンで表示します
# （動画の読み込みが減り、通信量と表示が軽くなります）。
# ffprobe があると再生時間と解像度も記録します。
#
# 未インストールでもアップロードは成功し、サムネイルが付かないだけです（機能が自動で無効になります）。
#   Ubuntu/Debian: sudo apt install ffmpeg
#   macOS:         brew install ffmpeg
#   Windows:       winget install Gyan.FFmpeg
#
# 実行ファイルの場所が PATH に無い場合はフルパスで指定してください（.cmd ラッパーも可）。
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# -----------------------------------------------------------------
# 検索索引とリモートコンテンツの保存（DB の肥大化対策）
# -----------------------------------------------------------------
# リレーに参加していると 1 日で数万件のリモート投稿が届き、DB が急速に膨らみます。
# Mastodon / Misskey と同じく、既定では「リモート投稿の本文を検索索引に入れない」
# 「フォロー外のリモートブーストを保存しない」ようになっています。
# （管理画面 → サーバー設定 からも変更できます。そちらが優先されます）
#
# FTS 索引の範囲:
#   local   : ローカル投稿のみ（既定・Mastodon / Misskey 相当。検索はローカル投稿だけが対象）
#   follows : 加えてフォロー中アクターの投稿と、自分の投稿への返信も索引する
#   all     : すべての投稿を索引する（旧来の挙動。リレー経由の投稿ぶん容量を使います）
# FTS_INDEX_SCOPE=local
#
# リモートのブースト（リノート）の保存:
#   follows : フォロー中アクターのものだけ保存（既定）
#   all     : すべて保存（旧来の挙動）
#   none    : リモートのブーストは保存しない
# REMOTE_ANNOUNCE_POLICY=follows
#
# 既存データへ遡って適用するには（サーバー停止推奨）:
#   npm run db:maintenance -- --apply

# -----------------------------------------------------------------
# 運用の自動化（毎日 1 回の整理とバックアップ）
# -----------------------------------------------------------------
# リモート投稿の整理・方針の適用・バックアップを、サーバー常駐のまま毎日 1 回実行します。
# 空いた領域を実際に解放する VACUUM だけは排他ロックが要るため自動では行いません
# （サーバーを停止して `npm run db:maintenance -- --apply` を実行してください）。
# 管理画面のダッシュボードから ON/OFF・実行時刻・「いますぐ実行」を操作できます。
#
# 自動整理を行うか（既定 true）
# AUTO_MAINTENANCE=true
# 実行時刻（0〜23・ローカル時刻。既定 4 = 午前4時以降の最初のチェックで実行）
# AUTO_MAINTENANCE_HOUR=4
# 整理の前にバックアップを取るか（既定 true）
# AUTO_BACKUP=true
# バックアップの保持世代数（既定 3）
# BACKUPS_KEEP=3

# -----------------------------------------------------------------
# 画像プロキシ（リモート画像の直リンク解消）
# -----------------------------------------------------------------
# リモートのアイコン・添付画像を相手サーバーから直接読むと、閲覧者の IP と
# User-Agent が相手に渡ります。有効にすると、このノードが取得してキャッシュし、
# 署名付き URL（/proxy?url=...&s=...）で配信します。既定で有効です。
#
# 有効/無効（既定 true。管理画面 → ダッシュボード →「容量とメンテナンス」からも変更可）
# IMAGE_PROXY=true
# キャッシュの上限（MB。既定 512。超えると最終使用が古いものから削除）
# IMAGE_PROXY_MAX_MB=512
# キャッシュの保持日数（既定 30。毎日の自動整理と db:maintenance で削除）
# IMAGE_PROXY_TTL_DAYS=30

# -----------------------------------------------------------------
# メール通知（SMTP 設定時のみ）
# -----------------------------------------------------------------
# SMTP を設定していないサーバーでは機能ごと無効で、設定画面にも表示されません。
# 受け取るかどうかはユーザーごとのオプトイン（既定 OFF）で、
# 種類別の通知設定で切った種類はメールも飛びません。
#
# 機能の有効/無効（既定 true）
# EMAIL_NOTIFICATIONS=true
# まとめ送りまでの待ち時間（秒。既定 60。0 で即時送信）
# EMAIL_BATCH_SECONDS=60
# 同じユーザーへ送る最短間隔（分。既定 5）
# EMAIL_THROTTLE_MINUTES=5
