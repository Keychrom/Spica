# =================================================================
# ✦ Spica - Node Configuration (.env.example)
#
# このファイルを `.env` にコピーして、お使いの環境に合わせて設定してください。
# コマンド例: cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. サーバーネットワーク基本設定
# -----------------------------------------------------------------
# Node.js サーバーがリッスンするポート番号
PORT=3000

# バインドするIPアドレス (0.0.0.0 で全インターフェースをリッスン)
BIND_HOST=0.0.0.0

# 外部公開する完全修飾ドメイン名 (FQDN)
# ※プロトコル (https://) や末尾スラッシュは含めないでください
# 例: spica.example.com / localhost:3000
DOMAIN=spica.example.com

# 通信プロトコル (https または http)
# ※インターネット公開時は必ず https を指定してください
PROTOCOL=https

# -----------------------------------------------------------------
# 2. データベース設定
# -----------------------------------------------------------------
# SQLite データベースファイルの保存パス (相対パスまたは絶対パス)
DB_PATH=data_astrabit.sqlite

# -----------------------------------------------------------------
# 3. インスタンス・サーバー情報設定
# -----------------------------------------------------------------
# サーバーの名前
INSTANCE_NAME=Spica

# サーバーの紹介・説明文
INSTANCE_DESCRIPTION=Spica - A decentralized, sovereign social network node built from scratch with ActivityPub.

# -----------------------------------------------------------------
# 4. メディアオブジェクトストレージ設定 (任意)
#
# Cloudflare R2、Amazon S3、MinIO などの S3 互換ストレージを利用する場合に指定します。
# 未設定の場合は、サーバーローカルの `data/uploads` ディレクトリに保存されます。
# -----------------------------------------------------------------
# S3 互換ストレージのエンドポイント URL
# 例 (Cloudflare R2): https://<account_id>.r2.cloudflarestorage.com
# 例 (Amazon S3): https://s3.ap-northeast-1.amazonaws.com
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# 保存先バケット名
# S3_BUCKET=spica-media

# リージョン (Cloudflare R2 の場合は auto)
# S3_REGION=auto

# S3 アクセスキー ID
# S3_ACCESS_KEY_ID=your-access-key-id

# S3 シークレットアクセスキー
# S3_SECRET_ACCESS_KEY=your-secret-access-key

# アップロードしたメディアの公開 URL
# 例: https://media.example.com または https://pub-<hash>.r2.dev
# S3_PUBLIC_URL=https://media.example.com

# -----------------------------------------------------------------
# 5. Web Push 通知設定 (任意)
#
# PWA / モバイルブラウザ向け Web Push 通知用の VAPID 鍵です。
# ※未設定の場合、初回起動時に自動生成されてデータベースに保存されます。
# -----------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# -----------------------------------------------------------------
# 6. Inbox 署名検証 (HTTP Signature) 設定
#
# 受信した ActivityPub の Activity を、送信元の署名で検証します。
# 既定 (strict) では検証に失敗した Activity を 401 で拒否し、
# なりすまし投稿・改ざん・リプレイ攻撃を防ぎます。
# -----------------------------------------------------------------
# 検証モード
#   strict: 検証失敗を拒否します (既定・推奨)
#   log:    警告ログのみで処理を続行します (従来挙動・非推奨)
#           ※誰でも任意のユーザーになりすまして投稿できる状態になります
INBOX_SIGNATURE_MODE=strict

# リレーによる代理転送 (他サーバーの Activity を自分の鍵で転送) の許可方針
#   relay: 管理パネルで承認済み (accepted) のリレーからの転送のみ許可 (既定・推奨)
#   any:   誰からの転送でも許可 (互換性最大・非推奨)
INBOX_FORWARDED_ACTIVITY_POLICY=relay

# 署名 Date ヘッダーの許容幅 (秒)。リプレイ攻撃対策。既定は 12 時間
SIGNATURE_MAX_AGE_SECONDS=43200

# プライベート IP・内部ホスト名への remote actor 取得を許可するか (SSRF 対策)
# 本番 (https 公開) では false を推奨。同一 LAN 内の自前ノードと連合テストする場合のみ true
# ALLOW_PRIVATE_REMOTE_FETCH=false

# -----------------------------------------------------------------
# 7. レート制限 (スパム・総当たり対策)
#
# 既定で有効です (認証 20回/分、API 600回/分、Inbox 3000回/分 を IP 単位で制限)。
# テストや特殊な運用で無効化したい場合のみ true にしてください。
# -----------------------------------------------------------------
# RATE_LIMIT_DISABLED=false

# -----------------------------------------------------------------
# 8. メディアアップロード上限 (任意)
#
# 動画・音声の1ファイルあたりの上限 (バイト)。既定は 50MB (52428800)。
# 画像は従来どおり 15MB 固定です。
# -----------------------------------------------------------------
# MEDIA_MAX_BYTES=52428800

# -----------------------------------------------------------------
# 9. メール送信 (SMTP) 設定 (任意)
#
# マスターキーの復元メールやメールアドレス確認に使う SMTP です。
# 通常は管理パネル「メール・認証」から設定してください (こちらが優先されます)。
# 未設定のあいだ、メール関連の機能は自動的に無効になります。
# -----------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com

# -----------------------------------------------------------------
# 10. Authorized Fetch (署名必須モード) 設定
#
# 有効にすると ActivityPub の取得 (Actor 文書・フォロワー一覧・ノート) に
# 有効な HTTP Signature を必須にし、こちらからの取得にも署名を付けます。
# WebFinger / NodeInfo / 管理API / 画面表示(HTML) / メディアは対象外です。
# ※鍵アカウント (フォロワー限定) の保護を実効化できますが、署名せずに取得して
#   くる相手 (古い実装など) からは取得できなくなり、連合の互換性は下がります。
# -----------------------------------------------------------------
# AUTHORIZED_FETCH=false

# -----------------------------------------------------------------
# 11. DB メンテナンス (任意)
#
# `npm run db:maintenance` で、リモート投稿の整理・孤立メディアの削除・
# VACUUM による縮小・VACUUM INTO によるバックアップを行います。
#
#   npm run db:maintenance              # ドライラン (何が消えるかを確認。何も消しません)
#   npm run db:maintenance -- --apply   # 実行 (先にバックアップを取ってから削除 + VACUUM)
#
# VACUUM は DB を排他ロックするため、サーバーを停止してから実行するのが確実です
# (バックアップと投稿削除はサーバー起動中でも動きます)。
#
# リレーに参加していると、リモート投稿が 1 日で数万件流入して DB が膨らみ続けます。
# 下記の保持日数を過ぎたリモート投稿を削除します (既定 30 日、0 で期間による削除なし)。
# コマンドの --days / --max-remote-posts で上書きできます。
# -----------------------------------------------------------------
# REMOTE_POST_RETENTION_DAYS=30

# -----------------------------------------------------------------
# 12. ドライブ (アップロード管理) 設定 (任意)
#
# アップロードしたメディアは「ドライブ」から一覧・削除できます
# (投稿に添付しなくても残り、使用量も確認できます)。
# 容量上限を MB 単位で指定できます (0 または未設定で無制限)。
# 上限を超えるアップロードは 413 で拒否され、ドライブに案内が表示されます。
# -----------------------------------------------------------------
# MEDIA_QUOTA_MB=1024

# -----------------------------------------------------------------
# 13. 動画サムネイル (ffmpeg) 設定 (任意)
#
# ffmpeg がインストールされていれば、動画アップロード時に先頭付近の 1 フレームから
# サムネイル (WebP) を生成し、タイムラインでは静止画＋再生ボタンで表示します。
# ffprobe があれば再生時間と解像度も記録します。
#
# ※未インストールでもアップロードは成功し、サムネイルが付かないだけです
#   (機能が自動的に無効になります)。
#   インストール例: sudo apt install ffmpeg / brew install ffmpeg / winget install Gyan.FFmpeg
#
# 実行ファイルが PATH に無い場合はフルパスで指定してください (.cmd ラッパーも可)。
# -----------------------------------------------------------------
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
